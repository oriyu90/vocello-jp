"Audio quality check passed." = "音声品質チェックに合格しました。";
"Audio quality check failed: %@" = "音声品質チェックに失敗しました：%@";
"Preparing batch..." = "一括生成を準備中…";
"%lld clips generated successfully." = "%lld個の音声を生成しました。";
"%lld of %lld clips generated before cancellation." = "キャンセル前に%1$lld／%2$lld個の音声を生成しました。";
"Batch generation stopped before any clips were saved. %@" = "音声が保存される前に一括生成が停止しました。%@";
